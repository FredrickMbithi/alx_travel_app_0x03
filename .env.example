# .env.example - safe placeholders for local development
# Copy this file to `.env` and fill in the real values (do NOT commit `.env`).

# Django settings
SECRET_KEY=change-me-to-a-secure-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Chapa API (payment provider)
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_PUBLIC_KEY=your_chapa_public_key
CHAPA_BASE_URL=https://api.chapa.co/v1

# Email (use app password for Gmail)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@travelapp.com

# Celery / Broker (RabbitMQ)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
